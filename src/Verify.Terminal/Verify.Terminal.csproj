<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <PackageId>Verify.Tool</PackageId>
    <ToolCommandName>dotnet-verify</ToolCommandName>
    <PackageIcon>icon.png</PackageIcon>
    <Description>A dotnet tool for managing Verify snapshots.</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\icon.png" Pack="true" PackagePath="\" />
    <PackageReference Include="DiffEngine" />
    <PackageReference Include="DiffPlex" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="Spectre.Console.Cli" />
    <PackageReference Include="Spectre.Console.Analyzer" PrivateAssets="all" />
    <PackageReference Include="Spectre.IO" />
    <PackageReference Include="Verify.ExceptionParsing" />
  </ItemGroup>

</Project>
