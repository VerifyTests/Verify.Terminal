<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Multi-targeted on purpose: this exercises Verify's multi-targeting naming, where the
         received file always carries a runtime and version suffix that the verified file does not. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Verify.XunitV3" VersionOverride="33.0.0-beta.4" />
    <PackageReference Include="xunit.v3" />
    <ProjectReference Include="..\Verify.Terminal\Verify.Terminal.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Shared with the other test project: both make inline queue exchanges. -->
    <Compile Include="..\Shared\DeadInlineQueue.cs" Link="DeadInlineQueue.cs" />
  </ItemGroup>
</Project>
