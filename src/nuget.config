<?xml version="1.0" encoding="utf-8"?>
<!--
TEMPORARY. Points at DiffEngine's working tree, packed by its pack-local.ps1, so this repo can
build against SettleAppliedInline before that API is released. Remove this file and put the
DiffEngine PackageVersion back to a published version once it is.
-->
<configuration>
  <packageSources>
    <add key="diffengine-local" value="..\..\DiffEngine\nugets" />
  </packageSources>
</configuration>
